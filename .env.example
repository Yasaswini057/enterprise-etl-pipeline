# ETL PostgreSQL connection. Docker Compose overrides DB_HOST with its service name.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=etl_warehouse
DB_USER=postgres
DB_PASSWORD=change_me
POSTGRES_PORT=5432

# Required for the existing real Stripe extraction.
STRIPE_SECRET_KEY=sk_test_replace_me

# Reserved for the existing Salesforce authentication utility.
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# Optional token for GitHub Issues API rate limits. The configured public
# repository works without it.
GITHUB_REPOSITORY=microsoft/vscode
GITHUB_TOKEN=

# Airflow Docker stack settings.
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=change_me
AIRFLOW_FERNET_KEY=
